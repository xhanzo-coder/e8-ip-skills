{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e8.local/schemas/visual-ip-style.schema.json",
  "title": "E8 视觉 IP 内置风格注册项",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "aliases",
    "catalog_preview",
    "catalog_primary_style",
    "catalog_summary",
    "catalog_best_for",
    "transformation_policy",
    "reference_maturity",
    "default_likeness",
    "definition",
    "reference_assets",
    "negative_examples",
    "supported_outputs",
    "unverified_outputs",
    "run_validator",
    "prompt_profiles"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "catalog_preview": {"type": "string", "pattern": "^assets/style-references/.+"},
    "catalog_primary_style": {"type": "string", "pattern": "^assets/style-references/.+"},
    "catalog_summary": {"type": "string", "minLength": 1},
    "catalog_best_for": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "transformation_policy": {"enum": ["surface-mapping", "structural-redraw"]},
    "reference_maturity": {"enum": ["single-reference", "limited-multi-reference", "multi-reference"]},
    "default_likeness": {"enum": ["symbolic", "interpreted", "recognizable", "close"]},
    "definition": {"type": "string", "pattern": "^references/styles/.+\\.md$"},
    "reference_assets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^assets/.+"}},
    "negative_examples": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^assets/.+"}},
    "supported_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["base-character", "turnaround", "avatar", "expression", "action", "sticker", "outfit", "scene"]}},
    "unverified_outputs": {"type": "array", "uniqueItems": true, "items": {"enum": ["base-character", "turnaround", "avatar", "expression", "action", "sticker", "outfit", "scene"]}},
    "run_validator": {"type": ["string", "null"], "pattern": "^scripts/.+\\.py$"},
    "prompt_profiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^references/.+\\.md$"}}
  }
}
